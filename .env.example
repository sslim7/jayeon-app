# .env로 복사해서 값 채우세요. EXPO_PUBLIC_* 만 앱 번들에 노출됩니다 — 서버 시크릿 금지.
# 각 항목에 [로컬] / [운영] 값을 적어 뒀습니다.

# 환경 이름 (development | production)
# 앱이 개발용 동작(디버그 로그·완화된 검증)을 켤지 판단하는 유일한 스위치입니다.
# 번들에 박히는 값이라 빌드 시점에 정해집니다 — 런타임에 바꿀 수 없습니다.
#   [로컬] development   [운영] production
EXPO_PUBLIC_ENV=development

# API 주소 (WAS)
# 끝에 슬래시를 붙이지 마세요. 앱이 경로를 그대로 이어 붙입니다.
#   [로컬] http://localhost:8080  (WAS 로컬 포트)
#   [운영] https://jayeon-api.redhead.kr
EXPO_PUBLIC_API_URL=http://localhost:8080

# 네이티브 껍데기의 웹뷰가 열 주소. **네이티브에서만 읽습니다.**
# 앱은 인증까지만 네이티브로 그리고, 그 다음 화면부터는 이 주소를 웹뷰로 띄웁니다.
# 화면을 앱에 복사하지 않는 이유는, 문구나 흐름을 고칠 때 스토어 심사를 다시 받지 않기 위해서입니다.
#   [로컬] http://localhost:8081  (아래 EXPO_DEV_PORT 로 띄운 dev 웹 서버와 같은 포트여야 합니다)
#   [운영] https://jayeon.redhead.kr
EXPO_PUBLIC_WEBVIEW_URL=http://localhost:8081

# 로컬 dev 서버 포트 (npm run dev / dev:web).
# scripts/start-dev.js 가 이 값을 읽어 `expo start --port` 로 넘깁니다.
# 위 EXPO_PUBLIC_WEBVIEW_URL 의 포트와 어긋나면 네이티브 웹뷰가 빈 화면을 띄웁니다.
#   [로컬] 8081   [운영] 사용 안 함 (웹 빌드는 정적 파일로 서빙)
EXPO_DEV_PORT=8081
